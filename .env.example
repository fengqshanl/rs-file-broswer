# 复制为 .env 后按需修改（该文件包含明文密码，已在 .gitignore 中排除）
ADMIN_USER=admin
# 至少 8 个字符；也可以改用 ADMIN_PASSWORD_HASH（Argon2 PHC 字符串）
ADMIN_PASSWORD=change-me-to-a-long-random-password

# 监听地址：默认仅本机。局域网/VPN 访问请改为对应内网 IP 或 0.0.0.0
LISTEN_IP=127.0.0.1
HOST_PORT=8090

# 对外提供的宿主机目录
FILES_DIR=./data

# TLS 证书中需要包含的地址（浏览器实际访问用的 IP / 域名）
TLS_EXTRA_IPS=127.0.0.1
TLS_EXTRA_DNS=localhost

# 带宽保护（MB/s，0 = 不限速），全局共享，不是每个连接
UPLOAD_RATE_MBPS=20
DOWNLOAD_RATE_MBPS=30

# 并发上限
MAX_CONCURRENT_UPLOADS=2
MAX_CONCURRENT_DOWNLOADS=2
# 预览请求并发（视频拖动进度条会产生多个短请求）
MAX_CONCURRENT_PREVIEWS=4
# 同时存在（未完成）的上传会话上限
MAX_ACTIVE_UPLOADS=32

# 单文件大小上限（GB）与磁盘安全余量（MB）
MAX_FILE_SIZE_GB=100
DISK_RESERVE_MB=2048

# 会话有效期（秒）与硬上限
SESSION_TTL_SECS=7200
SESSION_MAX_TTL_SECS=86400

# 登录失败防护
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECS=600

# RSA 密钥长度（首次启动时生成并缓存）
RSA_BITS=2048

TZ=Asia/Shanghai

# 中国大陆网络下构建镜像可指定镜像源
# RUST_IMAGE=docker.1ms.run/library/rust:1-alpine
# ALPINE_IMAGE=docker.1ms.run/library/alpine:3.20
