{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentGod Files Local",
  "mainBinaryName": "agentgod-files-local",
  "version": "0.1.5",
  "identifier": "com.agentgod.files.local",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "浏览本机与远程服务器文件",
    "longDescription": "AgentGod Files 本机版：无需登录即可浏览、上传、下载和预览本机文件，也可以连接多台远程 AgentGod Files 服务器。",
    "copyright": "MIT License",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "wix": {
        "language": [
          "zh-CN",
          "en-US"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NEM1RjM5ODlGREIzNTkKUldSWnMvMkpPVjlNNTNRRmNldk9uT1dqWXN2VjA0Uk9UUjNkT3R0U1ZlYyttMUdWN0ZMRmpGYjQK",
      "endpoints": [
        "https://github.com/fengqshanl/rs-file-broswer/releases/latest/download/latest-local.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
